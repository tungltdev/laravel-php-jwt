{
    "name": "tungltdev/laravel-php-jwt",
    "version": "3.3.0",
    "description": "A simple library to encode and decode JSON Web Tokens (JWT) in PHP.",
    "homepage": "https://github.com/tungltdev/laravel-php-jwt",
    "repository": {
        "type": "git",
        "url": "https://github.com/tungltdev/laravel-php-jwt.git"
    },
    "support": {
        "issues": "https://github.com/tungltdev/laravel-php-jwt/issues",
        "source": "https://github.com/tungltdev/laravel-php-jwt"
    },
    "authors": [
        {
            "name": "Tunglt",
            "email": "tunglt.dev@gmail.com",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "keywords": ["jwt", "laravel", "php", "authentication", "token"],
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.8"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Tungltdev\\LARAVEL\\JWT\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tungltdev\\LARAVEL\\JWT\\JwtAuthTokenProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
